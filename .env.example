# ==============================================================================
# VEIL Deepfake Defense — Environment Configuration Template
# Copy this file to `.env` for local configuration overrides.
# ==============================================================================

# Application runtime mode (development | production)
NODE_ENV=development

# Express API Server Port (default: 3001)
PORT=3001

# Backend API proxy target port used by Vite (default: 3001)
API_PORT=3001

# Logging verbosity (debug | info | warn | error)
LOG_LEVEL=info

# JWT & Session Cookie Secret (must be a random 32+ character string in production)
SESSION_SECRET=replace_with_a_secure_random_32_character_secret_key

# External ERP Clearance Gate API Key (used by SAP, NetSuite, Oracle integrations)
ERP_GATE_API_KEY=replace_with_a_secure_erp_gateway_api_key

# Python Audio Anti-Spoofing & Deepfake Model Service URL
MODEL_SERVICE_URL=http://127.0.0.1:5001
