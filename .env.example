# ==============================================================================
# VEIL Deepfake Defense — Environment Configuration Template
# Copy this file to `.env` for local configuration overrides.
# ==============================================================================

# Port for the Express API Server (default: 3001)
PORT=3001

# Port for the Frontend Vite Server (default: 3000)
# VITE_PORT=3000

# Backend API proxy target port used by Vite (default: 3001)
API_PORT=3001

# Database Connection (optional)
# By default, VEIL runs with an embedded SQLite database (zero-setup, local file).
# Set DATABASE_URL to connect to a production or development PostgreSQL instance:
# DATABASE_URL=postgresql://user:password@localhost:5432/veil_defense

# Application runtime mode (development | production)
NODE_ENV=development

# Logging verbosity (debug | info | warn | error)
LOG_LEVEL=info
